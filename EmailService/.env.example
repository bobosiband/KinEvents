# Email Service configuration — copy to .env and fill in before deploy.
# The deploy script reads this file and passes values as SAM NoEcho parameters.

# Gmail SMTP credentials
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Display name on outgoing emails
EMAIL_FROM_NAME=KinEvents

# Shared secret that callers put in the X-Api-Key request header
EMAIL_SERVICE_API_KEY=generate-a-long-random-string

# How long email logs live in DynamoDB before TTL deletes them
EMAIL_LOGS_RETENTION_DAYS=30
